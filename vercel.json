{
  "functions": {
    "api/generate-batch.js":      { "maxDuration": 300 },
    "api/generate-submit.js":     { "maxDuration": 15  },
    "api/generate-poll.js":       { "maxDuration": 60  },
    "api/cron-publish.js":        { "maxDuration": 60  },
    "api/cron-generate.js":       { "maxDuration": 300 },
    "api/queue-update.js":        { "maxDuration": 15  },
    "api/store-image.js":         { "maxDuration": 30  }
  },
  "crons": [
    { "path": "/api/cron-generate", "schedule": "0 6 */2 * *" }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" },
        { "key": "Clear-Site-Data", "value": "\"cache\"" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)",     "destination": "/index.html" }
  ]
}
