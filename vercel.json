{
  "functions": {
    "api/claude.js": {
      "maxDuration": 60
    },
    "api/generate-batch.js": {
      "maxDuration": 300
    },
    "api/cron-publish.js": {
      "maxDuration": 60
    },
    "api/fanvue-post.js": {
      "maxDuration": 30
    },
    "api/fanvue-upload.js": {
      "maxDuration": 30
    },
    "api/generate-image.js": {
      "maxDuration": 60
    },
    "api/generate-submit.js": {
      "maxDuration": 15
    },
    "api/generate-poll.js": {
      "maxDuration": 60
    },
    "api/fanvue-dm.js": {
      "maxDuration": 60
    },
    "api/cron-generate.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron-publish",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron-generate",
      "schedule": "0 6 */2 * *"
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
