{
  "name": "caig-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "mpt:worker": "node scripts/mpt-worker.mjs",
    "caption:worker": "node --env-file=.env.qwen.local scripts/caption-worker.mjs",
    "caption:whisper": ".venv-caption/bin/python scripts/mlx-whisper-server.py",
    "caption:whisper:setup": "bash scripts/setup-local-caption-worker.sh",
    "caption:whisper:health": "curl -fsS http://127.0.0.1:8787/health",
    "caption:whisper:check": "bash -lc 'test -x .venv-caption/bin/python && echo READY || echo NOT_INSTALLED'",
    "caption:whisper:start": "bash scripts/run-local-whisper.sh",
    "caption:whisper:install": "bash scripts/setup-local-caption-worker.sh",
    "caption:whisper:status": "bash -lc 'curl -fsS http://127.0.0.1:8787/health || true'",
    "caption:whisper:server": ".venv-caption/bin/python scripts/mlx-whisper-server.py",
    "qwen:server": "bash scripts/run-local-qwen.sh",
    "qwen:worker": "node --env-file=.env.qwen.local --import ./scripts/qwen-format-archaeology.mjs scripts/qwen-worker.mjs",
    "generations:sanitize": "node --env-file=.env.qwen.local scripts/sanitize-generation-history.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.104.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "vite": "^8.0.4"
  }
}
