# Browser-safe Supabase configuration for Vite
# These values are publishable; Supabase RLS remains the security boundary.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Local Qwen Vision (Mac only)
QWEN_VISION_HOST=127.0.0.1
QWEN_VISION_PORT=8001
QWEN_VISION_MODEL=mlx-community/Qwen2.5-VL-3B-Instruct-4bit
